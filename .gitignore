# Owasidea — ignore rules for every supported language and UI framework.
#
# Rule of thumb: generated output, caches, local state and secrets are ignored;
# sources, WIT contracts, lockfiles and test fixtures are committed. Patterns
# without a leading slash apply at every depth, so apps under examples/ and
# plugins/ inherit them; each example also ships its own .gitignore so it keeps
# working when copied out of this repository.

# --- Owasidea build output ---------------------------------------------------
# Manifests, permission snapshots and UI indexes are regenerated from WIT.
**/manifests/*.manifest.json
**/manifests/permissions.*.json
**/src/bindings.rs
**/.owasidea/
**/ui/public/plugins/
**/ui/public/ui-plugins.json
# Tauri config rendered by `owasidea config render`.
**/tauri.generated.conf.json
**/tauri.dev.conf.json
# Lifecycle installers (Linux, macOS, Windows).
*.AppImage
*.deb
*.rpm
*.dmg
*.msi
*.nsis
# Release metadata at the repository root.
/latest.json
/sbom.*.json
/provenance.intoto.json

# --- Wasm / component artifacts ---------------------------------------------
*.wasm
*.component.wasm
*.core.wasm

# --- Rust -------------------------------------------------------------------
target/
*.rs.bk
*.profraw
*.profdata

# --- Go ---------------------------------------------------------------------
# `vendor/` is intentionally not ignored: vendoring can be a deliberate choice.
bin/
*.test
*.prof
coverage.out

# --- JavaScript / TypeScript and UI frameworks ------------------------------
node_modules/
dist/
.vite/
.turbo/
.cache/
.parcel-cache/
.svelte-kit/
.next/
.nuxt/
.output/
.astro/
.solid/
.angular/
.vercel/
.netlify/
.wrangler/
coverage/
.nyc_output/
*.lcov
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# --- .NET / C# (Blazor, Uno, componentize-dotnet) ---------------------------
obj/
.vs/
TestResults/
*.user
*.suo
*.userosscache
*.sln.docstates
*.coverage
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# --- C / C++ ----------------------------------------------------------------
*.o
*.obj
*.a
*.lib
CMakeCache.txt
CMakeFiles/
cmake-build-*/
build/
gen/

# --- Python (repository tooling) -------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Tests and reports ------------------------------------------------------
test-results/
playwright-report/
blob-report/
reports/

# --- Local runtime state ----------------------------------------------------
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# --- Secrets and local configuration ---------------------------------------
keys/
*.key
*.pem
.env
.env.*
!.env.example

# --- Editors and operating systems -----------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# CodeGraph local index
.codegraph/
