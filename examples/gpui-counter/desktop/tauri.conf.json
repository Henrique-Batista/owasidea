{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gpui-counter",
  "version": "0.1.0",
  "identifier": "dev.owasidea.examples.gpui-counter",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "title": "gpui-counter" }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8810"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"]
  }
}
